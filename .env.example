# ============================================================
# Prode 2026 — variables de entorno
# Copiá este archivo a `.env.local` y completá con valores reales.
# NUNCA commitear .env.local
# ============================================================

# ---------- Database ----------
# Neon Postgres connection string
# Crear en https://console.neon.tech → copy connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# ---------- Auth ----------
# Auth.js v5 secret. Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth 2.0
# https://console.cloud.google.com/apis/credentials → Create OAuth client (Web)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email del admin único (acceso a /admin/*)
ADMIN_EMAIL="fernandezfederico1899@gmail.com"

# ---------- Cron secret ----------
# Generar con: openssl rand -hex 32
# Vercel cron usa Bearer ${CRON_SECRET} para autenticar /api/cron/*
CRON_SECRET=""

# ---------- API-Sports (api-football.com) ----------
# https://dashboard.api-football.com → Free plan
API_SPORTS_KEY=""
API_SPORTS_HOST="v3.football.api-sports.io"

# ---------- Resend (mails) ----------
# https://resend.com/api-keys
RESEND_API_KEY=""
# Formato: "Prode 2026 <noreply@tudominio.com>"
RESEND_FROM="Prode 2026 <onboarding@resend.dev>"

# ---------- Public (NEXT_PUBLIC_*) ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
